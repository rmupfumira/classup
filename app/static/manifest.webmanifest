{
  "name": "ClassUp — School Management",
  "short_name": "ClassUp",
  "description": "Multi-tenant school management for daycares, primary, and high schools — attendance, messaging, billing, accounting, and reports.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0C192C",
  "theme_color": "#1B3A6B",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity", "business"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/static/img/icons/icon-192.png",
      "sizes": "192x192",
